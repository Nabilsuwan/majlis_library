# Copy this to .env (in the same folder as docker-compose.yml) and fill in
# real values. Never commit .env itself.
#
# Make random values with:   openssl rand -hex 32

# Database password (any long random value)
DB_PASSWORD=change_me

# Signs staff logins. Copy the SAME value from Vercel (Settings ->
# Environment Variables -> SESSION_SECRET) if you want staff to stay
# logged in; otherwise any new random value works.
SESSION_SECRET=change_me

# Claude API key for reading book covers. Copy from Vercel.
ANTHROPIC_API_KEY=

# Encrypts credentials saved in n8n. Keep a copy somewhere safe — if it
# is lost, saved n8n credentials can't be decrypted.
N8N_ENCRYPTION_KEY=change_me

# Shared folder on the NAS that holds covers/ and backups/
NAS_ROOT=/share/Majlis
